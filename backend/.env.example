# ── LLM ──────────────────────────────────────────────────────────────────────
# Any OpenAI-compatible API endpoint (Ollama, DeepSeek, remote GPU, etc.)
LLM_BASE_URL=http://localhost:11434/v1

# Model name as returned by the provider.
# Ollama examples:   gemma3:4b, llama3.2, mistral
# DeepSeek examples: deepseek-chat, deepseek-reasoner
LLM_MODEL=gemma3:4b

# API key. For Ollama set any non-empty string — value is ignored.
# For cloud providers use the real key from their console.
LLM_API_KEY=ollama

# 0.0 = deterministic / strict. 1.0 = creative / varied.
# Recommended for QA review: 0.1–0.3
LLM_TEMPERATURE=0.2

# ── TestIT API ────────────────────────────────────────────────────────────────
# Base URL of your TestIT instance (no trailing slash).
TESTIT_BASE_URL=https://testit.example.com

# Private token for TestIT API auth.
# Get it in TestIT → Profile → API Tokens.
# This token NEVER leaves the backend — frontend does not see it.
TESTIT_PRIVATE_TOKEN=your_private_token_here

# Authorization scheme. TestIT default is "PrivateToken". Some setups use "Bearer".
TESTIT_AUTH_SCHEME=PrivateToken

# Request timeout in seconds.
TESTIT_TIMEOUT_SECONDS=30

# Set to false only if TestIT uses a self-signed certificate on an internal server.
TESTIT_VERIFY_SSL=true

# UUID of the TestIT project where AI drafts will be created.
# Find it in TestIT → Project Settings → ID.
TESTIT_PROJECT_UUID=your_project_uuid_here

# UUID of the section where AI drafts will be saved.
# Optional — if empty, the backend auto-creates "AI Review / Drafts" section.
TESTIT_DRAFT_SECTION_UUID=
