# Copy to .env in the project root: cp .env.example .env
# Loading order: root .env → backend/.env (override) → browser-use-runner/.env (override)

# ═══════════════════════════════════════════════════════════════════════════
# LLM — OpenAI-compatible endpoint, shared by backend + runner
# ═══════════════════════════════════════════════════════════════════════════
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here

# --- Provider examples ---
# OpenAI:   LLM_BASE_URL=https://api.openai.com/v1
# DeepSeek: LLM_BASE_URL=https://api.deepseek.com/v1
# Ollama:   LLM_BASE_URL=http://localhost:11434/v1, LLM_API_KEY=ollama
#   Inside Docker use host.docker.internal instead of localhost:
#     LLM_BASE_URL=http://host.docker.internal:11434/v1
#   On Linux also add to docker-compose.yml: extra_hosts: ["host.docker.internal:host-gateway"]

# --- Per-service model overrides ---
# Review / Improve (backend) — needs structured JSON output; gpt-4o-mini works fine
LLM_MODEL=gpt-4o-mini
# browser-use Runner — multi-step web agent; strong reasoning model recommended
# Falls back to LLM_MODEL if unset.
RUNNER_LLM_MODEL=gpt-4o

LLM_TEMPERATURE=0.2
LLM_TEMPERATURE_REVIEW=0.1
LLM_TEMPERATURE_IMPROVE=0.3
LLM_TIMEOUT_SECONDS=120

# Ollama only: overrides its default 4096-token context window (num_ctx).
# Leave unset for OpenAI-compatible providers that don't support it.
# LLM_NUM_CTX=8192

# ═══════════════════════════════════════════════════════════════════════════
# TestIT
# ═══════════════════════════════════════════════════════════════════════════
TESTIT_BASE_URL=https://testit.example.com
TESTIT_PRIVATE_TOKEN=your_private_token_here
TESTIT_AUTH_SCHEME=PrivateToken
TESTIT_TIMEOUT_SECONDS=30
TESTIT_VERIFY_SSL=true
TESTIT_PROJECT_UUID=your_project_uuid_here
TESTIT_DRAFT_SECTION_UUID=

# ═══════════════════════════════════════════════════════════════════════════
# Service URLs (backend → browser-use-runner)
# ═══════════════════════════════════════════════════════════════════════════
# In Docker Compose this is overridden automatically to the container DNS
# name (browser-use-runner:8008). Value below is for local dev outside Docker.
RUNNER_URL=http://localhost:8008
RUNNER_TIMEOUT_SEC=180
# Absolute path to browser-use-runner/runs — required for screenshot serving
# in local dev outside Docker.
# RUNNER_RUNS_DIR=/home/user/projects/qa-ai-tool/browser-use-runner/runs

# ═══════════════════════════════════════════════════════════════════════════
# browser-use Runner (port 8008)
# ═══════════════════════════════════════════════════════════════════════════
RUNNER_HEADLESS=true
RUNNER_USE_VISION=false
RUNNER_MAX_STEPS=30
RUNNER_LLM_TIMEOUT_SEC=90
RUNNER_NAVIGATION_TIMEOUT_SEC=90
RUNNER_NAVIGATION_WAIT_UNTIL=domcontentloaded
RUNNER_ACTION_TIMEOUT_SEC=180

# Preflight: check target URL is reachable before starting the agent
RUNNER_PREFLIGHT_URL=true
RUNNER_PREFLIGHT_TIMEOUT_SEC=45
RUNNER_PREFLIGHT_RETRIES=3
RUNNER_PREFLIGHT_VERIFY_SSL=false

# Let API request bodies override the RUNNER_* settings above (default: no).
# RUNNER_ALLOW_REQUEST_OVERRIDES=false
# Prepended to every agent's system prompt in addition to the built-in QA rules.
# RUNNER_SYSTEM_INSTRUCTIONS=

# ═══════════════════════════════════════════════════════════════════════════
# Frontend (local dev only — Docker sets this via docker-compose.yml)
# ═══════════════════════════════════════════════════════════════════════════
# VITE_BACKEND_URL=http://localhost:8000
