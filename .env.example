# ── LLM ──────────────────────────────────────────────────────────────────────
# OpenAI-compatible endpoint shared by all services.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here

# For Ollama: LLM_BASE_URL=http://localhost:11434/v1, LLM_API_KEY=ollama
#   Inside Docker use host.docker.internal instead of localhost:
#   LLM_BASE_URL=http://host.docker.internal:11434/v1
#   On Linux also add to docker-compose.yml: extra_hosts: ["host.docker.internal:host-gateway"]
# For DeepSeek: LLM_BASE_URL=https://api.deepseek.com/v1

# ── Per-service model overrides ───────────────────────────────────────────────
# Review / Improve (backend) — needs structured JSON output; gpt-4o-mini works fine
LLM_MODEL=gpt-4o-mini

# Stagehand Runner — browser automation; requires strong reasoning, use gpt-4o or better
# Falls back to LLM_MODEL if not set.
STAGEHAND_LLM_MODEL=gpt-4o

# Audit Runner (browser-use) — multi-step web agent; strong model recommended
# Falls back to LLM_MODEL if not set.
AUDIT_LLM_MODEL=gpt-4o

LLM_TEMPERATURE=0.2
LLM_TEMPERATURE_REVIEW=0.1
LLM_TEMPERATURE_IMPROVE=0.3
LLM_TIMEOUT_SECONDS=120

# ── TestIT ────────────────────────────────────────────────────────────────────
TESTIT_BASE_URL=https://testit.example.com
TESTIT_PRIVATE_TOKEN=your_private_token_here
TESTIT_AUTH_SCHEME=PrivateToken
TESTIT_TIMEOUT_SECONDS=30
TESTIT_VERIFY_SSL=true
TESTIT_PROJECT_UUID=your_project_uuid_here
TESTIT_DRAFT_SECTION_UUID=

# ── Service URLs (backend → runners) ─────────────────────────────────────────
# When running via Docker Compose these are overridden automatically to use
# container DNS names (stagehand-runner:8009, browser-use-runner:8008).
# Values below are for local development outside Docker.
RUNNER_URL=http://localhost:8009
AUDIT_RUNNER_URL=http://localhost:8008

# ── Stagehand Runner (port 8009) ──────────────────────────────────────────────
STAGEHAND_PORT=8009
STAGEHAND_HEADLESS=true
STAGEHAND_MAX_STEPS=20
# STAGEHAND_LLM_MODEL=gpt-4o  # also configurable here; overrides the global above
# Run data (screenshots, logs) saved to ./runs by default.
# STAGEHAND_RUNS_DIR=/custom/path
# Retention: keep runs for N days and at most N runs.
# STAGEHAND_RUNS_TTL_DAYS=7
# STAGEHAND_RUNS_MAX=100

# ── Audit Runner / browser-use (port 8008) ────────────────────────────────────
RUNNER_HEADLESS=true
RUNNER_USE_VISION=false
RUNNER_MAX_STEPS=30
RUNNER_LLM_TIMEOUT_SEC=90
RUNNER_NAVIGATION_TIMEOUT_SEC=90
RUNNER_NAVIGATION_WAIT_UNTIL=domcontentloaded
RUNNER_ACTION_TIMEOUT_SEC=180
RUNNER_PREFLIGHT_URL=true
RUNNER_PREFLIGHT_TIMEOUT_SEC=45
RUNNER_PREFLIGHT_RETRIES=3
RUNNER_PREFLIGHT_VERIFY_SSL=false
# BROWSER_USE_RUNNER_HOST=0.0.0.0
# BROWSER_USE_RUNNER_PORT=8008
# BROWSER_USE_LOGGING_LEVEL=info
