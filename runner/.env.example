# -----------------------------------------------------------------------------
# Runner server
# -----------------------------------------------------------------------------
BROWSER_USE_RUNNER_HOST=0.0.0.0
BROWSER_USE_RUNNER_PORT=8008

# browser-use log level: debug, info, warning, error
BROWSER_USE_LOGGING_LEVEL=info


# -----------------------------------------------------------------------------
# LLM — DeepSeek (default)
# -----------------------------------------------------------------------------
DEEPSEEK_API_KEY=

# DeepSeek model name
RUNNER_LLM_MODEL=deepseek-chat

# Seconds to wait for a single LLM response
RUNNER_LLM_TIMEOUT_SEC=90


# -----------------------------------------------------------------------------
# Browser
# -----------------------------------------------------------------------------
# true  = no browser window (production, servers)
# false = visible window (debugging only)
RUNNER_HEADLESS=true

# Send screenshots to LLM on each step.
# Keep false for DeepSeek — it doesn't support vision.
# The agent still sees the page via DOM/text and can interact with it.
RUNNER_USE_VISION=false


# -----------------------------------------------------------------------------
# Execution limits
# -----------------------------------------------------------------------------
# Maximum browser-use agent steps per task.
# Increase for complex multi-step flows.
RUNNER_MAX_STEPS=50

# Navigation timeout, seconds.
RUNNER_NAVIGATION_TIMEOUT_SEC=120

# When to consider navigation complete: load, domcontentloaded, networkidle, commit
# networkidle — better for SPA sites with dynamic content (waits for network quiet).
# domcontentloaded — faster but may miss JS-rendered elements.
RUNNER_NAVIGATION_WAIT_UNTIL=networkidle

# Single browser action timeout, seconds.
# Increase for slow forms with server-side validation.
RUNNER_ACTION_TIMEOUT_SEC=300


# -----------------------------------------------------------------------------
# URL preflight check
# -----------------------------------------------------------------------------
# start_url comes in /run JSON as field "start_url".
# If not provided, runner extracts the first http/https URL from "task" text.
# true = verify the URL is reachable before launching browser-use.
RUNNER_PREFLIGHT_URL=true

RUNNER_PREFLIGHT_TIMEOUT_SEC=45
RUNNER_PREFLIGHT_RETRIES=3

# false is useful for test environments with self-signed SSL certs.
RUNNER_PREFLIGHT_VERIFY_SSL=false


# -----------------------------------------------------------------------------
# Advanced
# -----------------------------------------------------------------------------
# Set to true to allow per-request overrides of runner settings.
# By default all runs use the settings above regardless of what the client sends.
# RUNNER_ALLOW_REQUEST_OVERRIDES=false
